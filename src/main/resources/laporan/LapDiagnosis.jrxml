<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="LapDiagnosis"
    language="java"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
>
    <property name="net.sf.jasperreports.compiler.source" value="17"/>
    <property name="net.sf.jasperreports.compiler.target" value="17"/>
    <parameter name="dari" class="java.sql.Date"/>
    <parameter name="sampai" class="java.sql.Date"/>
    <queryString><![CDATA[SELECT d.kode_diagnosis, d.nama_diagnosis, COUNT(*) AS jml FROM rekam_medis r JOIN diagnosis d ON r.kode_diagnosis=d.kode_diagnosis JOIN kunjungan k ON r.id_kunjungan=k.id_kunjungan WHERE k.tanggal BETWEEN $P{dari} AND $P{sampai} GROUP BY d.kode_diagnosis, d.nama_diagnosis ORDER BY jml DESC]]></queryString>
    <field name="kode_diagnosis" class="java.lang.String"/>
    <field name="nama_diagnosis" class="java.lang.String"/>
    <field name="jml" class="java.lang.Long"/>
    <variable name="sumJml" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{jml}]]></variableExpression>
    </variable>
    <title>
        <band height="112">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="8" mode="Opaque" backcolor="#0D7A5F"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="12" width="555" height="24" forecolor="#0D7A5F"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[KLINIK GIGI SEHAT]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="36" width="555" height="14" forecolor="#6B7280"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Jl. Senyum Sehat No.12, Jakarta | Telp 021-12345678 | Senin-Sabtu 09.00-20.00]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="53" width="555" height="1" forecolor="#0D7A5F"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#0D7A5F"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="58" width="555" height="22"/>
                <textElement textAlignment="Center">
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DIAGNOSIS TERBANYAK]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="82" width="555" height="16" forecolor="#374151"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Periode: "+$P{dari}+" s/d "+$P{sampai}+" | Tanpa identitas pasien"]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="80"
                    height="24"
                    mode="Opaque"
                    backcolor="#0D7A5F"
                    forecolor="#FFFFFF"
                />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Kode ICD]]></text>
            </staticText>
            <staticText>
                <reportElement
                    x="80"
                    y="0"
                    width="355"
                    height="24"
                    mode="Opaque"
                    backcolor="#0D7A5F"
                    forecolor="#FFFFFF"
                />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Nama Diagnosis]]></text>
            </staticText>
            <staticText>
                <reportElement
                    x="435"
                    y="0"
                    width="120"
                    height="24"
                    mode="Opaque"
                    backcolor="#0D7A5F"
                    forecolor="#FFFFFF"
                />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Jumlah]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="80" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{kode_diagnosis}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="355" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_diagnosis}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="435" y="0" width="120" height="20"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{jml}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#0D7A5F"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#0D7A5F"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="0" y="4" width="350" height="16" forecolor="#6B7280"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Dicetak: "+new java.util.Date()+" | SIM Klinik Gigi"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="4" width="200" height="16" forecolor="#6B7280"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Hal "+$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <summary>
        <band height="110">
            <rectangle>
                <reportElement x="0" y="6" width="555" height="30" mode="Opaque" backcolor="#E6F4F0"/>
                <graphicElement>
                    <pen lineWidth="0.7" lineColor="#0D7A5F"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="11" width="280" height="20" forecolor="#0D7A5F"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL KASUS :]]></text>
            </staticText>
            <textField>
                <reportElement x="292" y="11" width="150" height="20" forecolor="#0D7A5F"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{sumJml}+" kasus"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="355" y="45" width="200" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Jakarta, ....................]]></text>
            </staticText>
            <staticText>
                <reportElement x="355" y="60" width="200" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Pemilik Klinik,]]></text>
            </staticText>
            <staticText>
                <reportElement x="355" y="90" width="200" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[( ............................ )]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
