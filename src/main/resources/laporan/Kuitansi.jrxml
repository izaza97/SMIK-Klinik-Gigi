    name="Kuitansi"
    language="java"
    whenNoDataType="AllSectionsNoDetail"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
>
    <property name="net.sf.jasperreports.compiler.source" value="17"/>
    <property name="net.sf.jasperreports.compiler.target" value="17"/>
    <parameter name="no_kuitansi" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="nama_pasien" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="alamat_pasien" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="tgl_bayar" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="nama_dokter" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="metode" class="java.lang.String">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="diskon_persen" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="diskon_nominal" class="java.lang.Long">
        <defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
    </parameter>
    <queryString><![CDATA[SELECT * FROM (SELECT 1 AS urut, 'PERAWATAN' AS tipe, l.nama_layanan AS jenis, CAST(t.tarif AS SIGNED) AS biaya, CAST(IFNULL(t.jumlah,1) AS SIGNED) AS jml, CAST(t.tarif * IFNULL(t.jumlah,1) AS SIGNED) AS total, TRIM(CONCAT('Gigi ', IFNULL(t.no_gigi,''), ' ', IFNULL(dg.nama_diagnosis,''), ' ', IFNULL(t.keterangan,''))) AS ket FROM tindakan_kunjungan t JOIN layanan l ON t.kode_layanan=l.kode_layanan JOIN kunjungan k ON t.id_kunjungan=k.id_kunjungan LEFT JOIN rekam_medis rm ON rm.id_kunjungan=k.id_kunjungan LEFT JOIN diagnosis dg ON rm.kode_diagnosis=dg.kode_diagnosis WHERE t.id_kunjungan = (SELECT id_kunjungan FROM pembayaran WHERE no_kuitansi = $P{no_kuitansi}) AND (l.kategori IS NULL OR l.kategori NOT IN ('Produk','Obat')) UNION ALL SELECT 2 AS urut, 'PRODUK' AS tipe, l.nama_layanan AS jenis, CAST(t.tarif AS SIGNED) AS biaya, CAST(IFNULL(t.jumlah,1) AS SIGNED) AS jml, CAST(t.tarif * IFNULL(t.jumlah,1) AS SIGNED) AS total, IFNULL(l.keterangan,'') AS ket FROM tindakan_kunjungan t JOIN layanan l ON t.kode_layanan=l.kode_layanan WHERE t.id_kunjungan = (SELECT id_kunjungan FROM pembayaran WHERE no_kuitansi = $P{no_kuitansi}) AND l.kategori IN ('Produk','Obat')) AS gab ORDER BY urut, jenis]]></queryString>
    <field name="urut" class="java.lang.Integer"/>
    <field name="tipe" class="java.lang.String"/>
    <field name="jenis" class="java.lang.String"/>
    <field name="biaya" class="java.lang.Long"/>
    <field name="jml" class="java.lang.Long"/>
    <field name="total" class="java.lang.Long"/>
    <field name="ket" class="java.lang.String"/>
    <variable
        name="no_urut"
        class="java.lang.Integer"
        resetType="Group"
        resetGroup="gTipe"
        incrementType="None"
        calculation="Count"
    >
        <variableExpression><![CDATA[$F{jenis}]]></variableExpression>
        <initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
    </variable>
    <variable name="sumGroup" class="java.lang.Long" resetType="Group" resetGroup="gTipe" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
        <initialValueExpression><![CDATA[new Long(0)]]></initialValueExpression>
    </variable>
    <variable name="sumGrand" class="java.lang.Long" resetType="Report" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
        <initialValueExpression><![CDATA[new Long(0)]]></initialValueExpression>
    </variable>
