<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LapTindakan" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
  <property name="net.sf.jasperreports.compiler.source" value="17"/>
  <property name="net.sf.jasperreports.compiler.target" value="17"/>
  <parameter name="dari" class="java.sql.Date"/>
  <parameter name="sampai" class="java.sql.Date"/>
  <queryString><![CDATA[SELECT l.nama_layanan, COUNT(*) AS jml, SUM(t.tarif * IFNULL(t.jumlah,1)) AS pendapatan FROM tindakan_kunjungan t JOIN layanan l ON t.kode_layanan=l.kode_layanan JOIN kunjungan k ON t.id_kunjungan=k.id_kunjungan WHERE k.tanggal BETWEEN $P{dari} AND $P{sampai} GROUP BY l.nama_layanan ORDER BY jml DESC]]></queryString>
  <field name="nama_layanan" class="java.lang.String"/>
  <field name="jml" class="java.lang.Long"/>
  <field name="pendapatan" class="java.math.BigDecimal"/>
  <variable name="totPend" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{pendapatan}]]></variableExpression></variable>
  <title><band height="112">
    <rectangle><reportElement x="0" y="0" width="555" height="8" mode="Opaque" backcolor="#0D7A5F"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
    <staticText><reportElement x="0" y="12" width="555" height="24" forecolor="#0D7A5F"/><textElement textAlignment="Center"><font size="18" isBold="true"/></textElement><text><![CDATA[KLINIK GIGI SEHAT]]></text></staticText>
    <staticText><reportElement x="0" y="36" width="555" height="14" forecolor="#6B7280"/><textElement textAlignment="Center"><font size="8"/></textElement><text><![CDATA[Jl. Senyum Sehat No.12, Jakarta | Telp 021-12345678 | Senin-Sabtu 09.00-20.00]]></text></staticText>
    <line><reportElement x="0" y="53" width="555" height="1" forecolor="#0D7A5F"/><graphicElement><pen lineWidth="1.5" lineColor="#0D7A5F"/></graphicElement></line>
    <staticText><reportElement x="0" y="58" width="555" height="22"/><textElement textAlignment="Center"><font size="13" isBold="true"/></textElement><text><![CDATA[LAPORAN TINDAKAN DAN PRODUK]]></text></staticText>
    <textField><reportElement x="0" y="82" width="555" height="16" forecolor="#374151"/><textElement textAlignment="Center"><font size="9"/></textElement><textFieldExpression><![CDATA["Periode: "+$P{dari}+" s/d "+$P{sampai}]]></textFieldExpression></textField>
  </band></title>
  <columnHeader><band height="24">
    <staticText><reportElement x="0" y="0" width="275" height="24" mode="Opaque" backcolor="#0D7A5F" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Nama Layanan]]></text></staticText>
    <staticText><reportElement x="275" y="0" width="100" height="24" mode="Opaque" backcolor="#0D7A5F" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Jumlah]]></text></staticText>
    <staticText><reportElement x="375" y="0" width="180" height="24" mode="Opaque" backcolor="#0D7A5F" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Pendapatan (Rp)]]></text></staticText>
  </band></columnHeader>
  <detail><band height="20">
    <textField><reportElement x="0" y="0" width="275" height="20"/><box><pen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nama_layanan}]]></textFieldExpression></textField>
    <textField><reportElement x="275" y="0" width="100" height="20"/><box><pen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{jml}]]></textFieldExpression></textField>
    <textField pattern="#,##0"><reportElement x="375" y="0" width="180" height="20"/><box><pen lineWidth="0.5" lineColor="#E5E7EB"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{pendapatan}]]></textFieldExpression></textField>
  </band></detail>
  <pageFooter><band height="24">
    <line><reportElement x="0" y="0" width="555" height="1" forecolor="#0D7A5F"/><graphicElement><pen lineWidth="1.0" lineColor="#0D7A5F"/></graphicElement></line>
    <textField><reportElement x="0" y="4" width="350" height="16" forecolor="#6B7280"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA["Dicetak: "+new java.util.Date()+" | SIM Klinik Gigi"]]></textFieldExpression></textField>
    <textField><reportElement x="355" y="4" width="200" height="16" forecolor="#6B7280"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA["Hal "+$V{PAGE_NUMBER}]]></textFieldExpression></textField>
  </band></pageFooter>
